meta {
  name: 01 Create Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/customers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Piero",
    "lastName": "llanos",
    "email": "piero.llanos@gmail.com",
    "documentNumber": "76543210"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) {
    bru.setEnvVar("customerId", body.id);
  }
}
