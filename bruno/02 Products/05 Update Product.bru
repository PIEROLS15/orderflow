meta {
  name: 05 Update Product
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/products/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Webcam HD Pro",
    "description": "Camara full HD para reuniones",
    "price": 150.00,
    "stock": 10,
    "active": true
  }
}
